{
  "name": "fliptrack",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "scripts": {
    "dev": "node --watch --import remix/node-tsx server.ts",
    "hmr": "node hmr.ts",
    "start": "node --import remix/node-tsx server.ts",
    "test": "remix test",
    "typecheck": "tsc --noEmit",
    "db:migrate": "node --import remix/node-tsx db-cli.ts migrate",
    "db:status": "node --import remix/node-tsx db-cli.ts status"
  },
  "engines": {
    "node": ">=24.3.0",
    "pnpm": ">=11"
  },
  "dependencies": {
    "pg": "8.23.0",
    "remix": "3.0.0-beta.10"
  },
  "devDependencies": {
    "@types/node": "latest",
    "@types/pg": "8.23.1",
    "embedded-postgres": "18.1.0-beta.16",
    "playwright": "1.62.1",
    "typescript": "latest"
  }
}
