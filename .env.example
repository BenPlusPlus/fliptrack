# Required. Postgres connection string.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/fliptrack

# Required. Signs the session cookie. Use a long random string.
SESSION_SECRET=change-me-to-a-long-random-string

# First-run / break-glass wizard gate. Not the Operator password.
# Delete this after the first Operator exists if you want the lever gone.
SETUP_SECRET=change-me

# Optional. Defaults to 44100.
PORT=44100
